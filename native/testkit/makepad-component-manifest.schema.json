{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/makepad-component-manifest/v1",
  "type": "object",
  "required": ["schema_version", "component_count", "category_counts", "components"],
  "properties": {
    "schema_version": {"const": "tessera/makepad-component-manifest/v1"},
    "component_count": {"const": 101},
    "category_counts": {
      "type": "object",
      "required": ["Base", "Business", "Charts"],
      "properties": {
        "Base": {"const": 75},
        "Business": {"const": 11},
        "Charts": {"const": 15}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 101,
      "maxItems": 101,
      "items": {
        "type": "object",
        "required": ["id", "category", "kind", "strategy", "status", "source_ref", "owner", "implementation", "case_ids", "evidence_refs", "constraints"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "category": {"enum": ["Base", "Business", "Charts"]},
          "kind": {"enum": ["primitive", "composite", "service", "content", "chart"]},
          "strategy": {"enum": ["native-direct", "native-recompose", "deferred", "not-applicable"]},
          "status": {"enum": ["planned", "blocked", "verified"]},
          "source_ref": {"type": "string", "pattern": "^design/[^#]+#[^#]+$"},
          "owner": {
            "type": "object",
            "required": ["product", "ui", "engineering", "test", "security"],
            "properties": {
              "product": {"type": "string", "minLength": 1},
              "ui": {"type": "string", "minLength": 1},
              "engineering": {"type": "string", "minLength": 1},
              "test": {"type": "string", "minLength": 1},
              "security": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "implementation": {
            "type": "object",
            "required": ["rust", "gallery_route", "docs", "theme_style", "structure_style"],
            "properties": {
              "rust": {"type": "string", "minLength": 1},
              "gallery_route": {"type": "string", "minLength": 1},
              "docs": {"type": "string", "minLength": 1},
              "theme_style": {"type": "string", "minLength": 1},
              "structure_style": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "case_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["revision", "binary_sha256", "ledger_sha256", "sealed", "evidence_path"],
              "properties": {
                "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "ledger_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "sealed": {"const": true},
                "evidence_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
              },
              "additionalProperties": false
            }
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["code", "reason", "alternative", "owner", "deadline"],
              "properties": {
                "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
                "reason": {"type": "string", "minLength": 1},
                "alternative": {"type": "string", "minLength": 1},
                "owner": {"type": "string", "minLength": 1},
                "deadline": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "verified"}}},
            "then": {
              "properties": {
                "strategy": {"enum": ["native-direct", "native-recompose"]},
                "case_ids": {"minItems": 1},
                "evidence_refs": {"minItems": 1}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "planned"}}},
            "then": {
              "properties": {
                "strategy": {"enum": ["native-direct", "native-recompose"]},
                "evidence_refs": {"maxItems": 0}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "blocked"}}},
            "then": {
              "properties": {
                "strategy": {"const": "deferred"},
                "evidence_refs": {"maxItems": 0}
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
