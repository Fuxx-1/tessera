def canonical_kind(component_id: str, category: str) -> str:
    if category == "Charts":
        return "chart"
    if component_id in {"app", "config-provider", "util"}:
        return "service"
    if component_id in {
        "avatar",
        "badge",
        "calendar",
        "card",
        "carousel",
        "collapse",
        "descriptions",
        "empty",
        "image",
        "list",
        "popover",
        "qr-code",
        "segmented",
        "statistic",
        "table",
        "tag",
        "timeline",
        "tooltip",
        "tour",
        "tree",
        "metric-card",
        "mini-chart-card",
        "property-list",
        "status-timeline",
        "code-block",
        "markdown-editor",
        "mermaid-svg-viewer",
        "mobile-preview-frame",
    }:
        return "content"
    if component_id in {"button", "float-button", "icon", "typography", "divider", "space", "border-beam", "watermark"}:
        return "primitive"
    return "composite"


def expected_docs_path(component_id: str) -> str:
    return canonical_docs_path(Path("."), component_id)


def expected_impl_marker(kind: str, component_id: str, label: str) -> str:
    return f"blocked:no Makepad {label} for {component_id} ({kind})"


def verify_relative_path(root: Path, value: str, code: str, label: str, errors: list[dict[str, str]]) -> None:
    if not isinstance(value, str) or not value.strip():
        errors.append(issue(code, f"{label} must be a non-empty string"))
        return
    if safe_placeholder(value):
        errors.append(issue(code, f"{label} cannot be a placeholder"))
        return
    lowered = value.lower()
    if any(marker in lowered for marker in FORBIDDEN_MARKERS) or has_forbidden_marker(value):
        errors.append(issue(code, f"{label} contains a forbidden legacy path or fallback marker"))
        return
    file_part = split_ref(value)[0]
    path = Path(file_part)
    if path.is_absolute() or ".." in path.parts:
        errors.append(issue(code, f"{label} must stay within the repository"))
        return
    resolved = (root / path).resolve()
    try:
        resolved.relative_to(root.resolve())
    except ValueError:
        errors.append(issue(code, f"{label} must stay within the repository"))
        return
    if not resolved.exists():
        errors.append(issue(code, f"{label} path does not exist: {file_part}"))


def validate_component_paths(root: Path, component: dict[str, object], expected: dict[str, str], errors: list[dict[str, str]]) -> None:
    component_id = str(component["id"])
    source_ref = component.get("source_ref")
    if not isinstance(source_ref, str) or not source_ref.strip():
        errors.append(issue("MANIFEST_SOURCE_REF", f"{component_id} source_ref must be a non-empty string"))
        return
    if source_ref != expected["source_ref"]:
        errors.append(issue("MANIFEST_SOURCE_REF", f"{component_id} source_ref must be {expected['source_ref']}"))
    source_path, source_anchor = split_ref(source_ref)
    if any(marker in source_ref.lower() for marker in FORBIDDEN_MARKERS) or has_forbidden_marker(source_ref):
        errors.append(issue("MANIFEST_SOURCE_REF", f"{component_id} source_ref contains a forbidden legacy marker"))
    source_parts = Path(source_path)
    if not source_path or source_parts.is_absolute() or ".." in source_parts.parts:
        errors.append(issue("MANIFEST_SOURCE_REF", f"{component_id} source_ref must be a safe relative file path"))
        return
    source_file = (root / source_parts).resolve()
    try:
        source_file.relative_to(root.resolve())
    except ValueError:
        errors.append(issue("MANIFEST_SOURCE_REF", f"{component_id} source_ref must stay within the repository"))
        return
    if not source_file.exists():
        errors.append(issue("MANIFEST_SOURCE_REF", f"{component_id} source_ref file does not exist"))
    elif source_anchor:
        anchor_slug = slugify(source_anchor)
        text = source_file.read_text(encoding="utf-8")
        headings = {
            slugify(match.group(1))
            for match in re.finditer(r"^##\s+([A-Z][A-Za-z0-9-]*)(?:\s|$)", text, re.M)
        }
        if anchor_slug not in headings:
            errors.append(issue("MANIFEST_SOURCE_REF", f"{component_id} source_ref anchor does not exist: {source_anchor}"))

    implementation = component.get("implementation")
    if not isinstance(implementation, dict):
        errors.append(issue("MANIFEST_IMPLEMENTATION", f"{component_id} implementation must be an object"))
        return
    docs = str(implementation.get("docs", ""))
    theme_style = str(implementation.get("theme_style", ""))
    structure_style = str(implementation.get("structure_style", ""))
    gallery_route = str(implementation.get("gallery_route", ""))
    rust = str(implementation.get("rust", ""))
    expected_docs = expected["docs"]
    if docs != expected_docs:
        errors.append(issue("MANIFEST_DOCS", f"{component_id} docs must be {expected_docs}"))
    verify_relative_path(root, docs, "MANIFEST_DOCS", "docs", errors)
    if theme_style != expected["theme_style"]:
        errors.append(issue("MANIFEST_THEME_STYLE", f"{component_id} theme_style must be {expected['theme_style']}"))
    verify_relative_path(root, theme_style, "MANIFEST_THEME_STYLE", "theme_style", errors)
    if structure_style != expected["structure_style"]:
        errors.append(issue("MANIFEST_STRUCTURE_STYLE", f"{component_id} structure_style must be {expected['structure_style']}"))
    verify_relative_path(root, structure_style, "MANIFEST_STRUCTURE_STYLE", "structure_style", errors)
    if component.get("status") == "verified":
        if not rust or rust.lower().startswith(("blocked:", "planned:")):
            errors.append(issue("MANIFEST_IMPLEMENTATION", f"{component_id} verified entry needs a real rust path"))
        if not gallery_route or gallery_route.lower().startswith(("blocked:", "planned:")):
            errors.append(issue("MANIFEST_IMPLEMENTATION", f"{component_id} verified entry needs a real gallery route"))
        expected_rust = f"native/crates/tessera-makepad/src/components/{component_id.replace('-', '_')}.rs"
        if split_ref(rust)[0] != expected_rust:
            errors.append(issue("MANIFEST_RUST_PATH", f"{component_id} rust path must be {expected_rust}"))
        else:
            verify_relative_path(root, rust, "MANIFEST_RUST_PATH", "rust", errors)
        if not gallery_route.startswith("native/crates/tessera-gallery/src/"):
            errors.append(issue("MANIFEST_GALLERY_ROUTE", f"{component_id} gallery route must use the Makepad Gallery source tree"))
        else:
            verify_relative_path(root, gallery_route, "MANIFEST_GALLERY_ROUTE", "gallery_route", errors)
    else:
        if any(marker in rust.lower() for marker in FORBIDDEN_MARKERS) or has_forbidden_marker(rust):
            errors.append(issue("MANIFEST_OLD_ICED_PATH", f"{component_id} rust implementation contains a legacy Iced path"))
        if any(marker in gallery_route.lower() for marker in FORBIDDEN_MARKERS) or has_forbidden_marker(gallery_route):
            errors.append(issue("MANIFEST_OLD_ICED_PATH", f"{component_id} gallery route contains a legacy Iced path"))
        if not rust.lower().startswith(("blocked:", "planned:")):
            errors.append(issue("MANIFEST_IMPLEMENTATION", f"{component_id} non-verified rust entry must be explicitly blocked or planned"))
        if not gallery_route.lower().startswith(("blocked:", "planned:")):
            errors.append(issue("MANIFEST_IMPLEMENTATION", f"{component_id} non-verified gallery route must be explicitly blocked or planned"))
    if safe_placeholder(rust) or safe_placeholder(gallery_route):
        errors.append(issue("MANIFEST_IMPLEMENTATION", f"{component_id} implementation fields cannot be placeholders"))


def validate_component(component: dict[str, object], root: Path, expected: dict[str, dict[str, str]], errors: list[dict[str, str]]) -> None:
    component_id = component.get("id")
    if not isinstance(component_id, str) or not component_id:
        errors.append(issue("MANIFEST_COMPONENT_ID", "component id must be a non-empty string"))
        return
    category = component.get("category")
    kind = component.get("kind")
    strategy = component.get("strategy")
    status = component.get("status")
    if category not in EXPECTED_COUNTS:
        errors.append(issue("MANIFEST_CATEGORY", f"{component_id} category must be one of {sorted(EXPECTED_COUNTS)}"))
    if kind not in ALLOWED_KIND:
        errors.append(issue("MANIFEST_KIND", f"{component_id} kind must be one of {sorted(ALLOWED_KIND)}"))
    if strategy not in ALLOWED_STRATEGY:
        errors.append(issue("MANIFEST_STRATEGY", f"{component_id} strategy must be one of {sorted(ALLOWED_STRATEGY)}"))
    if status not in ALLOWED_STATUS:
        errors.append(issue("MANIFEST_STATUS", f"{component_id} status must be one of {sorted(ALLOWED_STATUS)}"))

    if component_id not in expected["ids"]:
        errors.append(issue("MANIFEST_COMPONENT_EXTRA", f"extra component id: {component_id}"))
        return

    expected_component = expected["components"][component_id]
    if category != expected_component["category"]:
        errors.append(issue("MANIFEST_CATEGORY", f"{component_id} category must be {expected_component['category']}"))
    if kind != expected_component["kind"]:
        errors.append(issue("MANIFEST_KIND", f"{component_id} kind must be {expected_component['kind']}"))
    valid_state = (
        (status == "blocked" and strategy == "deferred")
        or (status == "planned" and strategy in {"native-direct", "native-recompose"})
        or (status == "verified" and strategy in {"native-direct", "native-recompose"})
    )
    if not valid_state:
        errors.append(
            issue(
                "MANIFEST_STATE_TRANSITION",
                f"{component_id} must be blocked/deferred, planned/native-*, or verified/native-*",
            )
        )

    owner = component.get("owner")
    if not isinstance(owner, dict):
        errors.append(issue("MANIFEST_OWNER", f"{component_id} owner must be an object"))
    else:
        for key in ("product", "ui", "engineering", "test", "security"):
            value = owner.get(key)
            if not isinstance(value, str) or not value.strip() or safe_placeholder(value):
                errors.append(issue("MANIFEST_OWNER", f"{component_id} owner.{key} must be a non-empty role string"))

    cases = component.get("case_ids")
    if not isinstance(cases, list):
        errors.append(issue("MANIFEST_CASE_IDS", f"{component_id} case_ids must be an array"))
    else:
        seen_cases: set[str] = set()
        for case in cases:
            if not isinstance(case, str) or not case.strip() or safe_placeholder(case):
                errors.append(issue("MANIFEST_CASE_IDS", f"{component_id} case_ids must contain only non-empty strings"))
            elif case in seen_cases:
                errors.append(issue("MANIFEST_CASE_IDS", f"{component_id} case_ids must be unique"))
            seen_cases.add(case)

    evidence_refs = component.get("evidence_refs")
    if not isinstance(evidence_refs, list):
        errors.append(issue("MANIFEST_EVIDENCE", f"{component_id} evidence_refs must be an array"))
        evidence_refs = []

    for ref in evidence_refs:
        if not isinstance(ref, dict):
            errors.append(issue("MANIFEST_EVIDENCE", f"{component_id} evidence_refs entries must be objects"))
            continue
        for key, pattern, code in (
            ("revision", r"^[a-f0-9]{40}$", "MANIFEST_EVIDENCE_HASH"),
            ("binary_sha256", r"^[a-f0-9]{64}$", "MANIFEST_EVIDENCE_HASH"),
            ("ledger_sha256", r"^[a-f0-9]{64}$", "MANIFEST_EVIDENCE_HASH"),
        ):
            value = ref.get(key)
            if not isinstance(value, str) or not re.fullmatch(pattern, value):
                errors.append(issue(code, f"{component_id} evidence_ref {key} is invalid"))
        if ref.get("sealed") is not True:
            errors.append(issue("MANIFEST_EVIDENCE_SEALED", f"{component_id} evidence_ref must be sealed"))
        evidence_path = ref.get("evidence_path")
        if not isinstance(evidence_path, str) or not evidence_path.strip():
            errors.append(issue("MANIFEST_EVIDENCE_PATH", f"{component_id} evidence_ref evidence_path is required"))
        else:
            verify_relative_path(root, evidence_path, "MANIFEST_EVIDENCE_PATH", "evidence_path", errors)

    constraints = component.get("constraints")
    if not isinstance(constraints, list) or not constraints:
        errors.append(issue("MANIFEST_CONSTRAINTS", f"{component_id} needs at least one machine-readable constraint"))
    else:
        for constraint in constraints:
            if not isinstance(constraint, dict):
                errors.append(issue("MANIFEST_CONSTRAINTS", f"{component_id} constraints must be objects"))
                continue
            for key in ("code", "reason", "alternative", "owner", "deadline"):
                value = constraint.get(key)
                if not isinstance(value, str) or not value.strip() or safe_placeholder(value):
                    errors.append(issue("MANIFEST_CONSTRAINTS", f"{component_id} constraint.{key} must be a non-empty value"))

    if status == "verified":
        if not cases:
            errors.append(issue("MANIFEST_CASE_IDS", f"{component_id} verified entry needs at least one case id"))
        if not evidence_refs:
            errors.append(issue("MANIFEST_EVIDENCE", f"{component_id} verified entry needs sealed evidence refs"))
        if evidence_refs:
            bindings = {
                (str(ref.get("revision")), str(ref.get("binary_sha256")), str(ref.get("ledger_sha256")))
                for ref in evidence_refs
                if isinstance(ref, dict)
            }
            if len(bindings) != 1:
                errors.append(issue("MANIFEST_EVIDENCE_BINDING", f"{component_id} verified evidence refs must bind the same revision, binary, and ledger"))
            if any(not isinstance(ref, dict) or ref.get("sealed") is not True for ref in evidence_refs):
                errors.append(issue("MANIFEST_EVIDENCE_SEALED", f"{component_id} verified evidence refs must all be sealed"))
    else:
        if evidence_refs:
            errors.append(issue("MANIFEST_EVIDENCE", f"{component_id} non-verified entry cannot carry evidence refs"))

    if contains_forbidden_marker(component):
        errors.append(issue("MANIFEST_FORBIDDEN_FALLBACK", f"{component_id} contains a forbidden GenericFallback or legacy Iced marker"))

    expected_paths = expected["paths"][component_id]
    validate_component_paths(root, component, expected_paths, errors)


def expected_component_metadata(design_root: Path, registry_path: Path, repo_root: Path) -> dict[str, object]:
    design_refs, design_ids = parse_design_ids(design_root)
    registry_ids = parse_registry_ids(registry_path)
    ids = {category: design_ids[category] for category in EXPECTED_COUNTS}
    expected_components: dict[str, dict[str, str]] = {}
    expected_ids: set[str] = set()
    for category, component_ids in ids.items():
        for component_id in component_ids:
            expected_ids.add(component_id)
            expected_components[component_id] = {
                "category": category,
                "kind": canonical_kind(component_id, category),
                "strategy": "deferred",
                "status": "blocked",
                "source_ref": design_refs[category][component_id],
                "docs": canonical_docs_path(repo_root, component_id),
                "theme_style": f"{canonical_theme_path(category)}#{component_id}",
                "structure_style": f"{canonical_structure_path(component_id)}#{component_name_to_doc(component_id)}",
            }
    return {
        "ids": expected_ids,
        "components": expected_components,
        "design_ids": ids,
        "registry_ids": registry_ids,
        "paths": {component_id: expected_components[component_id] for component_id in expected_components},
    }


def validate_manifest(manifest: dict[str, object], repo_root: Path, design_root: Path, registry_path: Path) -> list[dict[str, str]]:
    errors: list[dict[str, str]] = []
    if not isinstance(manifest, dict):
        return [issue("MANIFEST_PARSE", "manifest must be a JSON object")]
    if manifest.get("schema_version") != SCHEMA_VERSION:
        errors.append(issue("MANIFEST_SCHEMA_VERSION", "unsupported manifest schema version"))
        return errors
    for key in ("schema_version", "component_count", "category_counts", "components"):
        if key not in manifest:
            errors.append(issue("MANIFEST_REQUIRED", f"missing top-level field {key}"))
    components = manifest.get("components")
    if not isinstance(components, list):
        errors.append(issue("MANIFEST_COMPONENTS", "components must be an array"))
        return errors
    if manifest.get("component_count") != len(components):
        errors.append(issue("MANIFEST_COMPONENT_COUNT", f"component_count must be {len(components)}"))
    category_counts = manifest.get("category_counts")
    if not isinstance(category_counts, dict):
        errors.append(issue("MANIFEST_CATEGORY_COUNTS", "category_counts must be an object"))
    expected = expected_component_metadata(design_root, registry_path, repo_root)
    for category in EXPECTED_COUNTS:
        if expected["design_ids"][category] != expected["registry_ids"][category]:
            missing_ids = sorted(expected["registry_ids"][category] - expected["design_ids"][category])
            extra_ids = sorted(expected["design_ids"][category] - expected["registry_ids"][category])
            errors.append(
                issue(
                    "INVENTORY_SOURCE_MISMATCH",
                    f"{category} design/registry IDs differ; missing={missing_ids}, extra={extra_ids}",
                )
            )
    if isinstance(category_counts, dict):
        for category, count in EXPECTED_COUNTS.items():
            if category_counts.get(category) != count:
                errors.append(issue("MANIFEST_CATEGORY_COUNTS", f"{category} must contain {count} components"))

    manifest_ids: list[str] = []
    seen: set[str] = set()
    for component in components:
        if not isinstance(component, dict):
            errors.append(issue("MANIFEST_COMPONENT", "every component entry must be an object"))
            continue
        component_id = component.get("id")
        if isinstance(component_id, str):
            manifest_ids.append(component_id)
            if component_id in seen:
                errors.append(issue("MANIFEST_COMPONENT_DUPLICATE", f"duplicate component id: {component_id}"))
            seen.add(component_id)
        validate_component(component, repo_root, expected, errors)

    manifest_set = set(manifest_ids)
    missing = sorted(expected["ids"] - manifest_set)
    extra = sorted(manifest_set - expected["ids"])
    for component_id in missing:
        errors.append(issue("MANIFEST_COMPONENT_MISSING", f"missing component id: {component_id}"))
    for component_id in extra:
        errors.append(issue("MANIFEST_COMPONENT_EXTRA", f"extra component id: {component_id}"))

    if manifest_set & expected["ids"]:
        manifest_by_category = Counter()
        for component in components:
            if isinstance(component, dict) and isinstance(component.get("category"), str):
                manifest_by_category[component["category"]] += 1
        for category, count in EXPECTED_COUNTS.items():
            if manifest_by_category[category] != count:
                errors.append(issue("MANIFEST_CATEGORY_COUNTS", f"{category} must contain {count} components"))

    registry_ids = expected["registry_ids"]
    for category in EXPECTED_COUNTS:
        if manifest_set & expected["ids"]:
            category_ids = {item["id"] for item in components if isinstance(item, dict) and item.get("category") == category and isinstance(item.get("id"), str)}
            if category_ids != registry_ids[category]:
                missing_ids = sorted(registry_ids[category] - category_ids)
                extra_ids = sorted(category_ids - registry_ids[category])
                for component_id in missing_ids:
                    errors.append(issue("MANIFEST_COMPONENT_MISSING", f"missing {category} id: {component_id}"))
                for component_id in extra_ids:
                    errors.append(issue("MANIFEST_COMPONENT_EXTRA", f"extra {category} id: {component_id}"))

    return errors


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("manifest", help="path to makepad-component-manifest-v1.json")
    parser.add_argument("--repo-root", type=Path, default=None)
    parser.add_argument("--design-root", type=Path, default=None)
    parser.add_argument("--registry", type=Path, default=None)
    args = parser.parse_args(argv)

    script_path = Path(__file__).resolve()
    repo_root = args.repo_root or canonical_repo_root(script_path)
    design_root = args.design_root or (repo_root / "design")
    registry_path = args.registry or (repo_root / "src/docs/componentRegistry.ts")
    manifest_path = Path(args.manifest)

    try:
        manifest = load_json(manifest_path)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"MANIFEST_PARSE: cannot parse manifest: {exc}", file=sys.stderr)
        return 1

    try:
        errors = validate_manifest(manifest, repo_root, design_root, registry_path)
    except Exception as exc:  # fail closed on unexpected internal failures
        print(f"MANIFEST_INTERNAL: {exc}", file=sys.stderr)
        return 1

    print(f"manifest_valid={str(not errors).lower()}")
    for error in errors:
        print(f"{error['code']}: {error['message']}", file=sys.stderr)
    return 0 if not errors else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
