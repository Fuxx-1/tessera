#!/usr/bin/env python3
"""Validate the frozen Makepad component inventory manifest."""

from __future__ import annotations

import argparse
import json
import re
import sys
from collections import Counter
from pathlib import Path

SCHEMA_VERSION = "tessera/makepad-component-manifest/v1"
EXPECTED_COUNTS = {"Base": 75, "Business": 11, "Charts": 15}
ALLOWED_STATUS = {"planned", "blocked", "verified"}
ALLOWED_KIND = {"primitive", "composite", "service", "content", "chart"}
ALLOWED_STRATEGY = {"native-direct", "native-recompose", "deferred", "not-applicable"}
PLACEHOLDERS = {"", "-", "na", "n/a", "none", "null", "todo", "tbd", "placeholder", "unknown"}
FORBIDDEN_MARKERS = (
    "genericfallback",
    "componentpreview",
    "component_preview",
    "tessera-iced",
    "native/crates/tessera-iced",
)


def issue(code: str, message: str) -> dict[str, str]:
    return {"code": code, "message": message}


def load_json(path: Path) -> dict[str, object]:
    return json.loads(path.read_text(encoding="utf-8"))


def slugify(value: str) -> str:
    value = value.strip()
    value = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1-\2", value)
    value = re.sub(r"([a-z0-9])([A-Z])", r"\1-\2", value)
    value = value.replace("_", "-")
    value = re.sub(r"-+", "-", value)
    return value.lower()


def component_name_to_doc(slug: str) -> str:
    special = {
        "qr-code": "QRCode",
    }
    if slug in special:
        return special[slug]
    return "".join(part.capitalize() for part in slug.split("-"))


def safe_placeholder(value: object) -> bool:
    return isinstance(value, str) and value.strip().lower() in PLACEHOLDERS


def has_forbidden_marker(value: object) -> bool:
    if not isinstance(value, str):
        return False
    compact = re.sub(r"[^a-z0-9]", "", value.lower())
    return any(
        marker in compact
        for marker in ("genericfallback", "componentpreview", "tesseraiced")
    )


def contains_forbidden_marker(value: object) -> bool:
    if isinstance(value, dict):
        return any(contains_forbidden_marker(item) for item in value.values())
    if isinstance(value, list):
        return any(contains_forbidden_marker(item) for item in value)
    return has_forbidden_marker(value)


def split_ref(value: str) -> tuple[str, str | None]:
    file_part, _, anchor = value.partition("#")
    return file_part, anchor or None


def canonical_repo_root(script_path: Path) -> Path:
    return script_path.resolve().parents[3]


def parse_design_ids(design_root: Path) -> tuple[dict[str, dict[str, str]], dict[str, set[str]]]:
    category_specs = {
        "Base": design_root / "02-base",
        "Business": design_root / "03-business",
        "Charts": design_root / "04-charts",
    }
    refs: dict[str, dict[str, str]] = {category: {} for category in category_specs}
    ids: dict[str, set[str]] = {category: set() for category in category_specs}
    heading_re = re.compile(r"^##\s+([A-Z][A-Za-z0-9-]*)(?:\s|$)")
    for category, directory in category_specs.items():
        for path in sorted(directory.glob("*.md")):
            for line in path.read_text(encoding="utf-8").splitlines():
                match = heading_re.match(line)
                if not match:
                    continue
                heading = match.group(1)
                slug = slugify(heading)
                ids[category].add(slug)
                # Textarea is intentionally documented once as an input and
                # once in the extensions section. Keep the extension ref as
                # the canonical traceability source while treating design IDs
                # as a set for the 101-item inventory.
                ref = f"{path.relative_to(design_root.parent)}#{heading}"
                if slug not in refs[category] or "08-extensions" in str(path):
                    refs[category][slug] = ref
    return refs, ids


def parse_registry_ids(registry_path: Path) -> dict[str, set[str]]:
    text = registry_path.read_text(encoding="utf-8")
    parsed: dict[str, set[str]] = {}
    for name in ("ComponentId", "CustomComponentId", "BusinessComponentId", "ChartComponentId"):
        match = re.search(rf"export type {name} =\n(.*?);", text, re.S)
        if not match:
            raise ValueError(f"missing {name} in registry")
        parsed[name] = set(re.findall(r'"([a-z0-9-]+)"', match.group(1)))
    return {
        "Base": parsed["ComponentId"] | parsed["CustomComponentId"],
        "Business": parsed["BusinessComponentId"],
        "Charts": parsed["ChartComponentId"],
    }


def canonical_docs_path(repo_root: Path, component_id: str) -> str:
    return f"src/docs/{component_name_to_doc(component_id)}Doc.tsx"


def canonical_theme_path(category: str) -> str:
    return {
        "Base": "design/01-foundations/07-interaction-states.md",
        "Business": "design/03-business/README.md",
        "Charts": "design/04-charts/README.md",
    }[category]


