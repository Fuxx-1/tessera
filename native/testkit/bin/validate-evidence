#!/usr/bin/env python3
"""Validate one finalized evidence bundle; --write records an excluded validation envelope."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))

from evidence_contract import load_json, validate_evidence, write_validation  # noqa: E402


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("evidence")
    parser.add_argument("--catalog", required=True)
    parser.add_argument("--crosswalk", required=True)
    parser.add_argument("--write", action="store_true")
    args = parser.parse_args(argv)
    evidence_path = Path(args.evidence)
    result = validate_evidence(load_json(evidence_path), load_json(Path(args.catalog)), load_json(Path(args.crosswalk)), evidence_path.parent)
    if args.write:
        write_validation(evidence_path.parent, result)
    print(f"evidence_valid={str(result['evidence_valid']).lower()}")
    for error in result["errors"]:
        print(f"{error['code']}: {error['message']}", file=sys.stderr)
    return 0 if result["evidence_valid"] else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
