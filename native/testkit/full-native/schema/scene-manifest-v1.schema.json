{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tessera full-native GUI scene contract",
  "type": "object",
  "required": ["schema_version", "registry_sha256", "component_count", "counts", "scenes"],
  "properties": {
    "schema_version": {"const": "tessera.full-native.scenes/v1"},
    "component_count": {"const": 101},
    "counts": {"type": "object"},
    "scenes": {"type": "array", "items": {"type": "object", "required": ["id", "component_id", "suite"]}}
  },
  "additionalProperties": false
}
