{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tessera full-native source coverage manifest",
  "type": "object",
  "required": ["schema_version", "verdict", "registry", "components", "errors"],
  "properties": {
    "schema_version": {"const": "tessera.full-native.coverage/v1"},
    "verdict": {"enum": ["pass", "blocked"]},
    "registry": {"type": "object", "required": ["count", "category_counts", "ids"]},
    "components": {"type": "array"},
    "errors": {"type": "array"}
  },
  "additionalProperties": true
}
