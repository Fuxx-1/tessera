{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tessera full-native GUI capture hook v2 result",
  "type": "object",
  "required": ["schema_version", "scenario_id", "status", "request", "provenance", "artifact_sha256", "evidence"],
  "properties": {
    "schema_version": {"const": "tessera.full-native.capture/v2"},
    "scenario_id": {"type": "string", "minLength": 1},
    "status": {"const": "captured"},
    "request": {
      "type": "object",
      "required": ["scene_id", "component_id", "theme", "viewport"],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "theme": {"type": "string", "minLength": 1},
        "viewport": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer"}, "height": {"type": "integer"}}}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_revision", "build_key", "scene_manifest_sha256", "binary_sha256"],
      "properties": {
        "source_revision": {"type": "string", "minLength": 1},
        "build_key": {"type": "string", "minLength": 1},
        "scene_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifact_sha256": {"type": "object", "required": ["capture.png", "geometry.json", "runtime.log", "keyboard_trace.json", "ax_snapshot.json"], "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "capture_png": {"type": "string"},
    "geometry_json": {"type": "string"},
    "evidence": {
      "type": "object",
        "required": ["evidence_id", "revision", "capture_kind", "assertion_facts", "blocked_capabilities", "interaction_plan"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "capture_kind": {"const": "gui"},
        "assertion_facts": {"type": "array"},
        "blocked_capabilities": {"type": "array", "items": {"type": "string"}},
        "interaction_plan": {"type": "object", "required": ["status", "postcondition"], "properties": {"status": {"enum": ["observed", "blocked"]}, "postcondition": {"type": "string", "minLength": 1}}, "additionalProperties": true},
        "keyboard_trace": {"type": "object", "required": ["input_origin", "steps"], "properties": {"input_origin": {"const": "platform_injected"}, "steps": {"type": "array", "maxItems": 32}}},
        "ax_snapshot": {"type": "object", "required": ["status", "nodes", "focused_ax_id", "internal_controls"], "properties": {"status": {"type": "string"}, "nodes": {"type": "array", "maxItems": 256}, "focused_ax_id": {}, "internal_controls": {"type": "array", "maxItems": 256}}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
