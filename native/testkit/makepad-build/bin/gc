#!/usr/bin/env python3
"""Census Makepad build roots and emit a mark-and-sweep dry-run plan."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _common import add_root_arguments, load_json_argument, roots_from_args, run, write_report  # noqa: E402
from makepad_build import gc_dry_run, quarantine_gc_candidates  # noqa: E402


def optional_json(args: argparse.Namespace, name: str) -> object | None:
    value = getattr(args, name)
    return load_json_argument(value) if value else None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--references")
    parser.add_argument("--authority-refs")
    parser.add_argument("--active-sessions")
    parser.add_argument("--feat-iced-refs")
    parser.add_argument("--current-release-refs")
    parser.add_argument("--sbom-refs")
    parser.add_argument("--manual-retained-roots")
    parser.add_argument("--recovery-archives")
    parser.add_argument("--policy")
    parser.add_argument("--doctor-ok", action="store_true")
    parser.add_argument("--allow-managed-root-scan", action="store_true")
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--confirm", action="store_true")
    parser.add_argument("--quarantine-root")
    parser.add_argument("--out")
    add_root_arguments(parser)
    args = parser.parse_args()
    roots = roots_from_args(args)
    policy = optional_json(args, "policy")
    if policy is not None and not isinstance(policy, dict):
        raise ValueError("policy must be a JSON object")
    report = gc_dry_run(
        roots,
        references=load_json_argument(args.references) if args.references else None,
        authority_refs=optional_json(args, "authority_refs"),
        active_sessions=optional_json(args, "active_sessions"),
        feat_iced_refs=optional_json(args, "feat_iced_refs"),
        current_release_refs=optional_json(args, "current_release_refs"),
        sbom_refs=optional_json(args, "sbom_refs"),
        manual_retained_roots=optional_json(args, "manual_retained_roots"),
        recovery_archives=optional_json(args, "recovery_archives"),
        doctor_ok=True if args.doctor_ok else False,
        policy=policy,
        allow_production_scan=args.allow_managed_root_scan,
    )
    if args.apply:
        moved = quarantine_gc_candidates(
            report,
            roots=roots,
            confirm=args.confirm,
            quarantine_root=args.quarantine_root,
        )
        report = dict(report)
        report["applied"] = True
        report["quarantined"] = moved
    else:
        report = dict(report)
        report["applied"] = False
    write_report(report, args.out)
    return 0 if report.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(run(main))
