#!/usr/bin/env python3
"""Run fail-closed Makepad build admission checks."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _common import add_root_arguments, load_json_argument, roots_from_args, run, write_report  # noqa: E402
from makepad_build import build_key, preflight_build  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--key", required=True)
    parser.add_argument("--target-dir", required=True)
    parser.add_argument("--lockfile", required=True)
    parser.add_argument("--estimated-peak-bytes", required=True, type=int)
    parser.add_argument("--repo-root")
    parser.add_argument("--command-json", help="JSON token array or array of token arrays")
    parser.add_argument("--volume-json", help="JSON object with independently measured volume facts")
    parser.add_argument("--jobs", type=int)
    parser.add_argument("--pressure")
    parser.add_argument("--out")
    add_root_arguments(parser)
    args = parser.parse_args()
    key_input = load_json_argument(args.key)
    if isinstance(key_input, dict) and isinstance(key_input.get("key"), dict):
        key_input = key_input["key"]
    if not isinstance(key_input, dict):
        raise ValueError("key input must be an object or build-key report")
    key = build_key(key_input, repo_root=args.repo_root, roots=roots_from_args(args))
    command = load_json_argument(args.command_json) if args.command_json else None
    volume = load_json_argument(args.volume_json) if args.volume_json else None
    if volume is not None and not isinstance(volume, dict):
        raise ValueError("volume-json must contain an object")
    report = preflight_build(
        key,
        cargo_target_dir=args.target_dir,
        lockfile_path=args.lockfile,
        estimated_peak_bytes=args.estimated_peak_bytes,
        roots=roots_from_args(args),
        repo_root=args.repo_root,
        command=command,
        requested_jobs=args.jobs,
        volume=volume,
        pressure=args.pressure,
    )
    write_report(report, args.out)
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(run(main))
