#!/usr/bin/env python3
"""Create one canonical Makepad build key."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _common import add_root_arguments, load_json_argument, roots_from_args, run, write_report  # noqa: E402
from makepad_build import build_key, ensure_key_json, key_json_path_for_key, validate_managed_path  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--input", required=True, help="build-key JSON input")
    parser.add_argument("--out", help="write canonical key.json atomically")
    parser.add_argument("--repo-root")
    add_root_arguments(parser)
    args = parser.parse_args()
    raw = load_json_argument(args.input)
    roots = roots_from_args(args)
    key, encoded, digest = build_key(raw, repo_root=args.repo_root, roots=roots)
    if args.out:
        output = validate_managed_path(
            args.out,
            roots.result_root,
            reject_private_tmp=not roots.fixture_mode,
        )
        expected = key_json_path_for_key(key, digest, roots)
        if output != expected:
            raise ValueError(f"--out must be the canonical key path: {expected}")
        ensure_key_json(key, roots)
        # ensure_key_json performed the exclusive, canonical write.
        if output.read_bytes() != encoded:
            raise ValueError("canonical key path contains different bytes")
    write_report({"key": key, "key_sha256": digest})
    return 0


if __name__ == "__main__":
    raise SystemExit(run(main))
