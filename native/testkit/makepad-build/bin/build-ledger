#!/usr/bin/env python3
"""Reserve, transition, seal, validate, and project Makepad build ledgers."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _common import add_root_arguments, load_json_argument, roots_from_args, run, write_report  # noqa: E402
from makepad_build import (  # noqa: E402
    ValidationError,
    build_key,
    ledger_path_for_key,
    new_ledger,
    publish_build_result,
    publish_ledger,
    read_json,
    reserve_ledger,
    seal_ledger,
    transition_ledger,
    validate_build_result,
    validate_ledger,
)


def add_ledger_root_args(parser: argparse.ArgumentParser) -> None:
    add_root_arguments(parser)
    parser.add_argument("--now", type=float)


def key_value(path: str) -> dict[str, object]:
    value = load_json_argument(path)
    if isinstance(value, dict) and isinstance(value.get("key"), dict):
        value = value["key"]
    if not isinstance(value, dict):
        raise ValueError("key input must be an object or build-key report")
    return value


def lease_value(path: str) -> dict[str, object]:
    value = load_json_argument(path)
    if not isinstance(value, dict):
        raise ValueError("lease input must be an object")
    return value


def add_transition_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--ledger", required=True)
    parser.add_argument("--lease-path", required=True)
    parser.add_argument("--lease", required=True)
    parser.add_argument("--state", required=True, choices=("running", "passed", "failed", "sealed"))
    parser.add_argument("--status")
    parser.add_argument("--artifacts")
    parser.add_argument("--evidence-refs")
    parser.add_argument("--out")
    add_ledger_root_args(parser)


def update_payload(record: dict[str, object], args: argparse.Namespace) -> None:
    if args.artifacts:
        artifacts = load_json_argument(args.artifacts)
        if not isinstance(artifacts, list):
            raise ValueError("artifacts input must be an array")
        record["artifacts"] = artifacts
    if args.evidence_refs:
        references = load_json_argument(args.evidence_refs)
        if not isinstance(references, list):
            raise ValueError("evidence-refs input must be an array")
        record["evidence_refs"] = references


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="operation", required=True)

    reserve = commands.add_parser("reserve")
    reserve.add_argument("--key", required=True)
    reserve.add_argument("--source-session", required=True)
    reserve.add_argument("--lease-path", required=True)
    reserve.add_argument("--lease", required=True)
    reserve.add_argument("--out")
    add_ledger_root_args(reserve)

    for name in ("transition", "seal"):
        command = commands.add_parser(name)
        add_transition_options(command)

    validate = commands.add_parser("validate")
    validate.add_argument("--ledger", required=True)
    validate.add_argument("--allow-unsealed", action="store_true")
    validate.add_argument("--no-hash", action="store_true")
    add_ledger_root_args(validate)

    result = commands.add_parser("publish-result")
    result.add_argument("--ledger", required=True)
    result.add_argument("--out")
    add_ledger_root_args(result)

    result_validate = commands.add_parser("validate-result")
    result_validate.add_argument("--result", required=True)
    result_validate.add_argument("--key")
    add_ledger_root_args(result_validate)

    args = parser.parse_args()
    roots = roots_from_args(args)
    if args.operation == "reserve":
        key = build_key(key_value(args.key), roots=roots)
        lease = lease_value(args.lease)
        output = Path(args.out) if args.out else ledger_path_for_key(key[0], key[2], roots)
        record = reserve_ledger(
            output,
            key,
            source_session=args.source_session,
            now=args.now,
            lease_path=args.lease_path,
            lease=lease,
            roots=roots,
        )
        write_report({"ok": True, "operation": "reserve", "ledger": record, "path": str(output)})
        return 0
    if args.operation in {"transition", "seal"}:
        raw = read_json(args.ledger)
        if not isinstance(raw, dict):
            raise ValueError("ledger input must be an object")
        update_payload(raw, args)
        lease = lease_value(args.lease)
        if args.operation == "seal" or args.state == "sealed":
            if args.state != "sealed":
                raise ValueError("seal operation requires sealed state")
            updated = seal_ledger(
                raw,
                roots=roots,
                now=args.now,
                lease_path=args.lease_path,
                lease=lease,
            )
        else:
            updated = transition_ledger(
                raw,
                args.state,
                status=args.status,
                now=args.now,
                lease_path=args.lease_path,
                lease=lease,
            )
        publish_ledger(
            args.ledger,
            updated,
            roots=roots,
            require_sealed=args.state == "sealed",
            lease_path=args.lease_path,
            lease=lease,
            now=args.now,
        )
        if args.out:
            publish_ledger(
                args.out,
                updated,
                roots=roots,
                require_sealed=args.state == "sealed",
                lease_path=args.lease_path,
                lease=lease,
                now=args.now,
            )
        write_report({"ok": True, "operation": args.operation, "ledger": updated})
        return 0
    if args.operation == "validate":
        errors = validate_ledger(
            args.ledger,
            roots=roots,
            require_sealed=not args.allow_unsealed,
            check_hashes=not args.no_hash,
        )
        write_report({"ok": not errors, "errors": errors})
        return 0 if not errors else 1
    if args.operation == "publish-result":
        projection = publish_build_result(args.ledger, roots=roots, result_path=args.out)
        write_report({"ok": True, "operation": "publish-result", "result": projection})
        return 0
    requested = key_value(args.key) if args.key else None
    errors = validate_build_result(args.result, roots=roots, requested_key=requested)
    write_report({"ok": not errors, "errors": errors})
    return 0 if not errors else 1


if __name__ == "__main__":
    raise SystemExit(run(main))
