{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/build-result/v1",
  "title": "Tessera Makepad derived sealed build result",
  "type": "object",
  "required": [
    "schema_version",
    "state",
    "status",
    "consumable",
    "key_sha256",
    "ledger_sha256",
    "ledger_ref",
    "source_revision",
    "profile",
    "profile_id",
    "lockfile_sha256",
    "artifacts",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "tessera/build-result/v1"},
    "state": {"const": "sealed"},
    "status": {"type": "string"},
    "consumable": {"type": "boolean"},
    "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_ref": {
      "type": "object",
      "required": ["root_id", "relative_path"],
      "properties": {
        "root_id": {"const": "results"},
        "relative_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "profile": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "lockfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "renderer": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array"},
    "evidence_refs": {"type": "array"},
    "created_at": {"type": "string", "format": "date-time"},
    "sealed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
