{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/build-ledger/v1",
  "title": "Tessera Makepad sealed build ledger",
  "type": "object",
  "required": [
    "schema_version",
    "ledger_id",
    "authority",
    "namespace",
    "source_revision",
    "source_session",
    "key",
    "key_sha256",
    "toolchain",
    "host",
    "target",
    "profile",
    "features",
    "renderer",
    "backend",
    "lockfile_sha256",
    "commands",
    "environment",
    "state",
    "status",
    "consumable",
    "created_at",
    "updated_at",
    "artifacts",
    "evidence_refs",
    "profile_id",
    "key_json_bytes_sha256",
    "outcome",
    "sealed_at",
    "lease_fingerprint",
    "transitions"
  ],
  "properties": {
    "schema_version": {"const": "tessera/build-ledger/v1"},
    "ledger_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "authority": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_session": {"type": "string", "minLength": 1},
    "key": {"$ref": "tessera/build-key/v1"},
    "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_json_bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolchain": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "target": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "profile": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "features": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "renderer": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "lockfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "state": {"enum": ["reserved", "running", "passed", "failed", "sealed"]},
    "status": {"enum": ["reserved", "running", "passed", "failed", "cancelled", "timeout", "orphaned_writer", "seal_error"]},
    "outcome": {"enum": ["pending", "passed", "failed"]},
    "consumable": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "sealed_at": {"type": ["string", "null"], "format": "date-time"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "lease_fingerprint": {"type": "object"},
    "transitions": {"type": "array", "items": {"type": "object"}},
    "target_root": {"type": "string"},
    "result_root": {"type": "string"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "kind", "root_id", "relative_path", "sha256", "size_bytes", "media_type", "retention_class"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "root_id": {"enum": ["target", "cache", "result", "results", "evidence"]},
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tree_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "retention_class": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
