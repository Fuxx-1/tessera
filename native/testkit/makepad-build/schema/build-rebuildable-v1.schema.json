{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/build-rebuildable/v1",
  "title": "Tessera Makepad rebuildability proof",
  "type": "object",
  "required": [
    "schema_version",
    "key_sha256",
    "key_json_bytes_sha256",
    "authority",
    "source_revision",
    "profile_id",
    "rebuildable"
  ],
  "properties": {
    "schema_version": {"const": "tessera/build-rebuildable/v1"},
    "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_json_bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "rebuildable": {"const": true}
  },
  "additionalProperties": false
}
