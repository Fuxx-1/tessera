{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/build-key/v1",
  "title": "Tessera Makepad canonical build key",
  "type": "object",
  "required": [
    "schema_version",
    "authority",
    "namespace",
    "source_revision",
    "toolchain",
    "host",
    "target",
    "profile",
    "features",
    "renderer",
    "backend",
    "lockfile_sha256",
    "commands",
    "environment"
  ],
  "properties": {
    "schema_version": {"const": "tessera/build-key/v1"},
    "authority": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "namespace": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "toolchain": {"type": "string"},
    "host": {"type": "string"},
    "target": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "profile": {"type": "string"},
    "features": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "renderer": {"type": "string"},
    "backend": {"type": "string"},
    "lockfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    },
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "manifest_path": {"type": "string", "pattern": "^(\\$REPO|\\$TESSERA_BUILD_CACHE|\\$TESSERA_BUILD_RESULTS|\\$TESSERA_EVIDENCE)(/.*)?$"},
    "working_directory": {"type": "string"},
    "target_dir": {"type": "string", "pattern": "^\\$TESSERA_BUILD_CACHE(/.*)?$"},
    "result_dir": {"type": "string", "pattern": "^\\$TESSERA_BUILD_RESULTS(/.*)?$"},
    "evidence_dir": {"type": "string", "pattern": "^\\$TESSERA_EVIDENCE(/.*)?$"}
  },
  "additionalProperties": false
}
