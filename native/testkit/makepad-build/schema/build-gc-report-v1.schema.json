{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/build-gc-report/v1",
  "title": "Tessera Makepad build cache GC dry-run report",
  "type": "object",
  "required": [
    "schema_version",
    "dry_run",
    "ok",
    "blocked",
    "errors",
    "roots",
    "entries",
    "candidates",
    "retained",
    "policy",
    "vws_doctor_ok",
    "candidate_count",
    "retained_count",
    "candidate_bytes"
  ],
  "properties": {
    "schema_version": {"const": "tessera/build-gc-report/v1"},
    "dry_run": {"const": true},
    "ok": {"type": "boolean"},
    "blocked": {"type": "boolean"},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "roots": {"type": "array", "items": {"type": "object"}},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "retained": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "policy": {
      "type": "object",
      "required": [
        "schema_version",
        "min_free_bytes",
        "min_free_percent",
        "failed_grace_seconds",
        "successful_profiles_per_key",
        "ssd_preferred",
        "quarantine_required"
      ],
      "properties": {
        "schema_version": {"const": "tessera/build-gc-policy/v1"},
        "min_free_bytes": {"type": "integer", "minimum": 0},
        "min_free_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "failed_grace_seconds": {"type": "integer", "minimum": 0},
        "successful_profiles_per_key": {"type": "integer", "minimum": 1},
        "ssd_preferred": {"type": "boolean"},
        "quarantine_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "vws_doctor_ok": {"type": "boolean"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "retained_count": {"type": "integer", "minimum": 0},
    "candidate_bytes": {"type": "integer", "minimum": 0},
    "volume": {"type": ["object", "null"]},
    "emergency": {"type": ["object", "null"]},
    "scanned_cache_root": {"type": "string"}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "build_id",
        "authority",
        "source_revision",
        "profile",
        "key_sha256",
        "path",
        "target_path",
        "result_dir",
        "result_path",
        "size_bytes",
        "state",
        "lease_state",
        "process_markers",
        "retained_reason",
        "safe_to_quarantine",
        "candidate"
      ],
      "properties": {
        "build_id": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "profile": {"type": "string", "minLength": 1},
        "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path": {"type": "string"},
        "target_path": {"type": "string"},
        "result_dir": {"type": "string"},
        "result_path": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "state": {"type": "string"},
        "status": {},
        "lease_state": {"type": "string"},
        "process_markers": {"type": "array"},
        "retained_reason": {"type": "array", "items": {"type": "string"}},
        "safe_to_quarantine": {"type": "boolean"},
        "candidate": {"type": "boolean"},
        "fingerprint": {"type": "array"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
