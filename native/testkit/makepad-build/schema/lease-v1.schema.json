{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/build-lease/v1",
  "title": "Tessera Makepad single-writer lease",
  "type": "object",
  "required": [
    "schema_version",
    "lease_id",
    "key_sha256",
    "source_revision",
    "writer_session",
    "pid",
    "process_start_token",
    "host_id",
    "acquired_at",
    "heartbeat_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "tessera/build-lease/v1"},
    "lease_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "writer_session": {"type": "string", "minLength": 1},
    "pid": {"type": "integer", "minimum": 1},
    "process_start_token": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "acquired_at": {"type": "string", "format": "date-time"},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "heartbeat_interval_seconds": {"type": "integer", "minimum": 1},
    "ttl_seconds": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
