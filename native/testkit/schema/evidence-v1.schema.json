{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera.iced.evidence/v1",
  "type": "object",
  "required": ["schema_version", "record_id", "run", "coverage_cell", "source", "authority", "applicability", "execution", "risk", "accepted_limitations", "runner", "artifacts", "evidence_metrics", "supersedes_record_id", "retest_ordinal", "handback_id"],
  "properties": {
    "schema_version": {"const": "tessera.iced.evidence/v1"},
    "record_id": {"type": "string", "pattern": "^EV-RUN-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}-[0-9]{3}-T-G0-[0-9]{3}$"},
    "run": {"type": "object", "required": ["run_id", "test_id", "kind", "layer", "milestone", "lane", "started_at", "finished_at"]},
    "coverage_cell": {"type": "object", "required": ["catalog_version", "cell_id", "product_requirement_ids", "test_requirement_ids", "test_id", "scenario_id", "layer", "platform_profile_id", "renderer", "system_scale", "ui_scale", "theme", "locale", "release_level", "assistive_tech", "gate_class", "metric_ids"]},
    "source": {"type": "object", "required": ["identity_kind", "repository_label", "revision", "workspace_manifest_sha256", "cargo_lock_sha256", "canonical_native_tree_sha256", "preflight"], "properties": {"identity_kind": {"const": "git_commit"}, "repository_label": {"type": "string"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "workspace_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "cargo_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "canonical_native_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "preflight": {"type": "object"}}, "additionalProperties": false},
    "authority": {"type": "object", "required": ["catalog_version", "catalog_sha256", "crosswalk_sha256", "catalog_artifact_id", "crosswalk_artifact_id"], "properties": {"catalog_version": {"const": "coverage-g0-v1"}, "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "crosswalk_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "catalog_artifact_id": {"type": "string"}, "crosswalk_artifact_id": {"type": "string"}}, "additionalProperties": false},
    "applicability": {"type": "object", "required": ["visual", "performance", "fault", "soak", "screen_reader"]},
    "execution": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["pass", "fail", "blocked", "inconclusive"]}}},
    "risk": {"type": "object", "required": ["findings"]},
    "accepted_limitations": {"type": "array"},
    "runner": {"type": "object", "required": ["runner_path", "runner_version", "bundle_created_before_target", "argv_artifact_id", "environment_artifact_id", "stdout_artifact_id", "stderr_artifact_id", "exit_code", "signal", "finalized_by", "finalization_once"], "properties": {"runner_path": {"const": "native/testkit/bin/run-evidence"}, "runner_version": {"type": "string"}, "bundle_created_before_target": {"const": true}, "argv_artifact_id": {"type": "string"}, "environment_artifact_id": {"type": "string"}, "stdout_artifact_id": {"type": "string"}, "stderr_artifact_id": {"type": "string"}, "exit_code": {"type": "integer"}, "signal": {"enum": [null, "SIGINT", "SIGTERM"]}, "finalized_by": {"enum": ["exit_trap", "signal_trap"]}, "finalization_once": {"const": true}}, "additionalProperties": false},
    "artifacts": {"type": "array"},
    "evidence_metrics": {"type": "array"},
    "visual": {"type": ["object", "null"]},
    "performance": {"type": ["object", "null"]},
    "fault": {"type": ["object", "null"]},
    "soak": {"type": ["object", "null"]},
    "documentation_dod": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"type": "object", "required": ["item_id", "owner", "status", "evidence_record_ids", "source_revision", "reviewed_at"], "properties": {"item_id": {"pattern": "^DOC-(0[1-9]|1[01])$"}, "status": {"enum": ["pass", "blocked", "not_applicable"]}, "evidence_record_ids": {"type": "array", "minItems": 1}, "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "reviewed_at": {"type": "string", "format": "date-time"}}, "additionalProperties": true}}}, "additionalProperties": false}]},
    "crate_contract": {"type": ["object", "null"]}
    ,"supersedes_record_id": {"type": ["string", "null"], "pattern": "^EV-RUN-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}-[0-9]{3}-T-G0-[0-9]{3}$"}
    ,"retest_ordinal": {"enum": [0, 1]}
    ,"handback_id": {"type": ["string", "null"], "pattern": "^HB-RUN-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}-[0-9]{3}$"}
  },
  "additionalProperties": true
}
