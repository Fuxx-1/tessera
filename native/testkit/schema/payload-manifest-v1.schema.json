{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera.iced.payload-manifest/v1",
  "type": "object",
  "required": ["schema_version", "run_id", "authority", "payload_files"],
  "properties": {
    "schema_version": {"const": "tessera.iced.payload-manifest/v1"},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}-[0-9]{3}$"},
    "authority": {"type": "object", "required": ["catalog_version", "catalog_sha256", "crosswalk_sha256"], "properties": {"catalog_version": {"const": "coverage-g0-v1"}, "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "crosswalk_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "payload_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "media_type", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "media_type": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "not": {"required": ["manifest_digest_sha256"]},
  "additionalProperties": false
}
