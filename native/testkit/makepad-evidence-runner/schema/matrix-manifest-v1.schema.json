{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/makepad-evidence-matrix/v1",
  "type": "object",
  "required": [
    "schema_version",
    "runner_version",
    "fixtures",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "const": "tessera/makepad-evidence-matrix/v1"
    },
    "runner_version": {
      "type": "string"
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "relative_path",
          "sha256"
        ]
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell_id",
          "case_id",
          "fixture_id",
          "platform",
          "device",
          "theme",
          "viewport",
          "system_scale",
          "app_scale",
          "content_profile",
          "input_profile",
          "lifecycle_profile",
          "requires"
        ]
      }
    }
  }
}
