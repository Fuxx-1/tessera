{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/makepad-artifacts/v1",
  "type": "object",
  "required": [
    "schema_version",
    "hashed_at",
    "state",
    "capture_source",
    "artifact_count",
    "real_artifact_count",
    "blocked_reasons",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "tessera/makepad-artifacts/v1"},
    "state": {"enum": ["hashed", "blocked"]},
    "capture_source": {"enum": ["state_only", "synthetic", "runtime_capture"]},
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "kind", "relative_path", "required", "synthetic_allowed", "present", "size_bytes", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "pattern": "^[^/].*"},
          "required": {"type": "boolean"},
          "synthetic_allowed": {"type": "boolean"},
          "present": {"type": "boolean"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
