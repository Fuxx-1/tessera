{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera/makepad-capability-probe/v1",
  "type": "object",
  "required": ["schema_version", "captured_at", "host", "platforms", "capabilities"],
  "properties": {
    "schema_version": {"const": "tessera/makepad-capability-probe/v1"},
    "captured_at": {"type": "string", "minLength": 1},
    "host": {"type": "object", "required": ["system", "machine", "python_version"]},
    "platforms": {
      "type": "object",
      "required": ["macos", "android", "ios", "windows", "linux"],
      "additionalProperties": {
        "type": "object",
        "required": ["status", "reason"],
        "properties": {
          "status": {"enum": ["supported", "blocked"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["windowserver", "accessibility", "ime", "mobile_runtime", "screen_capture", "macos_runner"],
      "additionalProperties": {"type": "object"}
    }
  }
}
